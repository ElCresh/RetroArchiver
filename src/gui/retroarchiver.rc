#include <windows.h>
#include <commctrl.h>
#include "resource.h"

/* manifest: common controls version 6, i.e. the XP look */
1 24 "retroarchiver.manifest"
/* icon: 16, 32 and 48 pixels; the 16 is drawn specifically for the title bar */
IDI_APP ICON "retroarchiver.ico"

/* The dialogs: positions in dialog units, so they follow the system font.
 * Every text is set by the code with tr() (the labels here are empty), in
 * the program's language. The widths leave room for the Italian texts. */

IDD_SETTINGS DIALOGEX 0, 0, 330, 252
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 1
BEGIN
    CONTROL "", IDC_TABS, "SysTabControl32", WS_TABSTOP, 7, 7, 316, 218
    DEFPUSHBUTTON "", IDOK, 213, 231, 52, 14
    PUSHBUTTON "", IDCANCEL, 271, 231, 52, 14
END

IDD_PG_GENERAL DIALOGEX 0, 0, 304, 196
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 1
BEGIN
    LTEXT "", IDC_UILANG_L, 6, 10, 92, 8
    COMBOBOX IDC_UILANG, 100, 8, 130, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_UILANG_H, 100, 24, 198, 16
    LTEXT "", IDC_FOLDER_L, 6, 48, 92, 8
    EDITTEXT IDC_FOLDER, 100, 46, 176, 12, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_FOLDER_B, 280, 46, 18, 12
    LTEXT "", IDC_MAXREADS_L, 6, 70, 92, 8
    EDITTEXT IDC_MAXREADS, 100, 68, 24, 12, ES_NUMBER
    LTEXT "", IDC_MAXREADS_H, 130, 70, 168, 24
    AUTOCHECKBOX "", IDC_SOUNDS, 6, 102, 292, 10
    LTEXT "", IDC_SOUNDS_H, 18, 115, 280, 24
END

IDD_PG_FLOPPY DIALOGEX 0, 0, 304, 196
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 1
BEGIN
    LTEXT "", IDC_SAMDISK_L, 6, 10, 92, 8
    EDITTEXT IDC_SAMDISK, 100, 8, 176, 12, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_SAMDISK_B, 280, 8, 18, 12
    LTEXT "", IDC_SAMDISK_H, 100, 23, 198, 16
    LTEXT "", IDC_READFROM_L, 6, 50, 92, 8
    EDITTEXT IDC_READFROM, 100, 48, 176, 12, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_READFROM_B, 280, 48, 18, 12
    LTEXT "", IDC_READFROM_H, 100, 63, 198, 24
    LTEXT "", IDC_FNAME_L, 6, 98, 92, 8
    EDITTEXT IDC_FNAME, 100, 96, 90, 12, ES_AUTOHSCROLL
    LTEXT "", IDC_FNAME_H, 100, 111, 198, 24
END

IDD_PG_OPTICAL DIALOGEX 0, 0, 304, 196
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 1
BEGIN
    LTEXT "", IDC_DIC_L, 6, 8, 92, 8
    EDITTEXT IDC_DIC, 100, 6, 176, 12, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_DIC_B, 280, 6, 18, 12
    LTEXT "", IDC_DRIVE_L, 6, 26, 92, 8
    COMBOBOX IDC_DRIVE, 100, 24, 40, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_CDNAME_L, 6, 44, 92, 8
    EDITTEXT IDC_CDNAME, 100, 42, 64, 12, ES_AUTOHSCROLL
    LTEXT "", IDC_DVDNAME_L, 172, 44, 58, 8
    EDITTEXT IDC_DVDNAME, 234, 42, 64, 12, ES_AUTOHSCROLL
    LTEXT "", IDC_DAT_L, 6, 62, 92, 8
    EDITTEXT IDC_DAT, 100, 60, 176, 12, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_DAT_B, 280, 60, 18, 12
    LTEXT "", IDC_DAT_H, 100, 74, 198, 8
    LTEXT "", IDC_OFFSET_L, 6, 90, 92, 8
    EDITTEXT IDC_OFFSET, 100, 88, 34, 12, ES_AUTOHSCROLL
    LTEXT "", IDC_OFFSET_H, 140, 87, 158, 16
    CONTROL "", IDC_OFFSET_LINK, "SysLink", WS_TABSTOP, 140, 104, 158, 9
    LTEXT "", IDC_NOLEADIN_L, 6, 120, 292, 16
    LISTBOX IDC_NOLEADIN, 6, 138, 230, 52, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON "", IDC_FORGET, 242, 138, 56, 14
END

IDD_PG_AUTO DIALOGEX 0, 0, 304, 196
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 1
BEGIN
    LTEXT "", IDC_AUTO_INTRO, 6, 8, 292, 24
    LTEXT "", IDC_COUNT_L, 6, 44, 92, 16
    EDITTEXT IDC_COUNT, 100, 42, 24, 12, ES_NUMBER
    LTEXT "", IDC_COUNT_U, 128, 44, 60, 8
    LTEXT "", IDC_COUNT_H, 100, 57, 198, 16
    LTEXT "", IDC_POLL_L, 6, 84, 92, 16
    EDITTEXT IDC_POLL, 100, 82, 24, 12, ES_NUMBER
    LTEXT "", IDC_POLL_U, 128, 84, 60, 8
    LTEXT "", IDC_POLL_H, 100, 97, 198, 24
    LTEXT "", IDC_AUTO_NOTE, 6, 136, 292, 24
END

IDD_ABOUT DIALOGEX 0, 0, 360, 250
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg", 0, 0, 1
BEGIN
    ICON IDI_APP, IDC_AB_ICON, 7, 7, 21, 20
    LTEXT "", IDC_AB_NAME, 38, 7, 315, 10
    LTEXT "", IDC_AB_TAGLINE, 38, 19, 315, 8
    CONTROL "", IDC_AB_LINK, "SysLink", WS_TABSTOP, 38, 30, 315, 9
    LTEXT "", IDC_AB_LICENSE, 38, 45, 250, 16
    PUSHBUTTON "", IDC_AB_LICVIEW, 293, 43, 60, 14
    LTEXT "", IDC_AB_TPTITLE, 7, 68, 346, 8
    CONTROL "", IDC_AB_LIST, "SysListView32",
            LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
            7, 79, 346, 112
    LTEXT "", IDC_AB_STATUS, 7, 195, 346, 24
    PUSHBUTTON "", IDC_AB_OPENLIC, 7, 229, 76, 14
    PUSHBUTTON "", IDC_AB_NOTICES, 87, 229, 106, 14
    PUSHBUTTON "", IDC_AB_COPY, 197, 229, 86, 14
    DEFPUSHBUTTON "", IDOK, 301, 229, 52, 14
END
