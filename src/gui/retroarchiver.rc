/* Upload to Archive.org: two tabs, then the box with the public warning,
 * and the same window becomes the progress once Upload is pressed */
IDD_IAUPLOAD DIALOGEX 0, 0, 350, 326
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 1
BEGIN
    CONTROL "", IDC_TABS, "SysTabControl32", WS_TABSTOP, 7, 7, 336, 196
    LTEXT "", IDC_IU_WARN, 7, 208, 336, 40, SS_NOPREFIX
    AUTOCHECKBOX "", IDC_IU_UNDERSTOOD, 7, 250, 336, 10
    LTEXT "", IDC_IU_PROG, 7, 250, 336, 10, SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL "", IDC_IU_BAR_FILE, "msctls_progress32", 0, 7, 263, 336, 8
    CONTROL "", IDC_IU_BAR_TOTAL, "msctls_progress32", 0, 7, 274, 336, 8
    EDITTEXT IDC_IU_URL, 7, 287, 282, 12, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON "", IDC_IU_OPEN, 293, 286, 50, 14
    /* Upload and Stop share one place: Stop only while uploading */
    DEFPUSHBUTTON "", IDC_IU_UPLOAD, 233, 305, 56, 14
    PUSHBUTTON "", IDC_IU_STOP, 233, 305, 56, 14
    PUSHBUTTON "", IDCANCEL, 293, 305, 50, 14
END

