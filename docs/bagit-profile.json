    "Title": { "required": true },
    "Platform": { "required": true },
    "Media-Type": { "required": true },
    "Media-Expected": { "required": true },
    "Media-Archived": { "required": true },
    "Box-Status": { "required": true, "values": ["completo", "incompleto"] },
