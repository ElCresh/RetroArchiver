setup.browse=Folder where the boxes are saved
setup.resume.none=There is no open box to resume in the folder %ls.\n\nIf it is in another folder, choose that one in Folder and press Resume again.
setup.resume.item.one=%ls  (%d of %d %ls done)
setup.resume.item.many=%ls  (%d of %d %ls done)

# the group boxes
group.box=Box
group.archiving=Archiving
group.bag=BagIt package
group.selected=Selected box

# what is missing before starting
missing.title=The box title is missing.
missing.platform=The platform is missing: choose one from the list or type it.
missing.media=The box media are missing: how many floppies, CDs and DVDs (1 to 64 in all).
missing.folder=The folder where the boxes are saved is missing.
missing.toolong=The folder path is too long: choose a shorter one.

# status bar, right part: the first thing missing, or Ready
ready.notitle=Title missing
ready.noplatform=Platform missing
ready.media=Media: 1 to 64
ready.nofolder=Folder missing
ready.samdisk.bad=SAMdisk needs fixing
ready.ok=Ready
ready.archive.loading=Reading the archive...
ready.verifying=Checking the hashes again...
ready.dic.bad=DiscImageCreator needs fixing

# SAMdisk, the floppy drive, DiscImageCreator
samdisk.checking=Checking SAMdisk...
samdisk.ok=SAMdisk %ls
samdisk.notfound=SAMdisk not found: check the SAMdisk field
samdisk.v4=SAMdisk 4.x: the 3.x series is needed (4.0 cannot read real floppies)
samdisk.notsamdisk=The program given does not look like SAMdisk
samdisk.wait=Still checking SAMdisk: try again in a moment.
samdisk.fix=%ls.\n\nIn the SAMdisk field write the full path of samdisk.exe from the 3.x series (for example C:\\SAMdisk\\samdisk.exe), or copy samdisk.exe next to RetroArchiver.exe and leave just samdisk in the field.
drive.checking=Checking drive %ls...
drive.ok=Drive %ls %d rpm
drive.dead=Drive %ls does not answer (is a disk in?)
dic.checking=Checking DiscImageCreator...
dic.ok=DiscImageCreator %ls, %ls
dic.notfound.brief=DiscImageCreator not found
dic.notfound=DiscImageCreator not found: check the field
dic.nodll.brief=DiscImageCreator: Visual C++ runtime missing
dic.nodll=DiscImageCreator does not start: the Visual C++ 2015-2019 x86 runtime is missing
dic.notdic.brief=not DiscImageCreator
dic.notdic=The program given does not look like DiscImageCreator
dat.none.brief=no redump DAT
dat.none=no redump DAT: two reads per disc
dat.old.brief=redump DAT %.10ls, old
dat.old=redump DAT of %.10ls, old: download a new one
dat.ok.brief=redump DAT %.10ls
dat.ok=redump DAT of %.10ls
dic.wait=Still checking DiscImageCreator: try again in a moment.
dic.fix=%ls.\n\nIn the DiscImageCreator field write the full path of DiscImageCreator.exe (for example C:\\DIC\\DiscImageCreator.exe), or copy it next to RetroArchiver.exe with its DLLs. Windows XP needs the Visual C++ 2015-2019 x86 runtime, version 14.27.

