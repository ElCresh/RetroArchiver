# modifica di un cofanetto chiuso
menu.edit=&Modifica cofanetto...
menu.delete=&Elimina cofanetto...
button.edit=Modifica
edit.title=Modifica di “%ls”
edit.tab.data=Cofanetto
edit.tab.media=Supporti
edit.reason=Motivo
edit.save=Salva
edit.save.read=Salva e leggi
edit.folder=Cartella: %ls
edit.folder.new=Cartella: %ls (ora %ls)
edit.count.floppy=Floppy
edit.count.cd=CD
edit.count.dvd=DVD
edit.column.method=Letto con
edit.column.drive=Lettore
edit.method.cd=cd (completo)
edit.method.data=data (solo i dati)
edit.added=aggiunto: da leggere
edit.media.hint=Spunta i supporti da rileggere, o da leggere se mancano. Ognuno si salva appena letto: resta la lettura migliore, l'altra va in set-aside. Un numero più basso toglie gli ultimi supporti di quel tipo: anche le loro letture vanno in set-aside.
edit.bad.count=Un cofanetto ha da 1 a %d supporti.
edit.none.ticked=Spunta almeno un supporto da leggere, oppure premi Salva.
edit.confirm=Salvare queste modifiche a “%ls”?\n\n%ls\nIl pacchetto si controlla, si modifica e si richiude. Non si cancella niente: ciò che si toglie va in set-aside.
edit.change.field=%ls: “%ls” -> “%ls”
edit.change.added=%ls aggiunto, da leggere
edit.change.removed=%ls tolto: le sue letture vanno in set-aside
edit.change.folder=Cartella: %ls -> %ls
edit.saving=Controllo e salvataggio di “%ls”...
edit.saved=“%ls” salvato: pacchetto richiuso e verificato.
edit.failed=Il cofanetto non è stato modificato: è com'era.\n\n%ls
edit.cannot=Questo cofanetto non si può modificare:\n%ls
edit.old.format=Fatto con RetroArchiver 261017: per modificarlo va prima convertito.
edit.recovered=Modifiche interrotte rimesse in ordine: %d. I cofanetti sono integri.
edit.worse.title=%ls %d: la lettura nuova è peggiore
edit.worse.text=Nel cofanetto resta la lettura di prima. Pulisci il disco e premi Riprova, oppure Salta per tenere quella di prima.
edit.done=Cofanetto modificato e richiuso
edit.done.text=%ls. Ogni supporto è stato salvato appena letto, e il pacchetto verificato.
edit.done.old=Cofanetto richiuso: alcune letture nuove erano peggiori
