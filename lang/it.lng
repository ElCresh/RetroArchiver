# automatic mode
auto.waiting=Lettura automatica: aspetto il disco nel lettore %ls
auto.count.one=Leggo il %ls fra un secondo
auto.count.many=Leggo il %ls fra %d secondi
auto.count.label=Etichetta: %ls.\s
auto.count.text=Esc ferma il conto alla rovescia e aspetta che premi Leggi (F5); Invio legge subito, Alt+S salta il disco.
auto.ask.title=Sembra lo stesso %ls del %ls: lo rileggo?
auto.ask.text=Ha lo stesso numero di serie (%04lX-%04lX)%ls del %ls già letto. Se è davvero il %ls premi Leggi (F5); altrimenti metti il %ls giusto e riparto da solo, oppure Salta (Alt+S).
auto.ask.samelabel=\se la stessa etichetta
auto.removed=Dischetto tolto dal lettore %ls: inserisci il successivo
auto.disc.removed=Disco tolto dal lettore %ls: inserisci il successivo
auto.slow=Il lettore risponde lento: noto il cambio solo se togli il dischetto e poi lo inserisci
auto.nodriver=Lettura automatica non disponibile: fdrawcmd.sys non risponde sul lettore %ls. Premi Leggi (F5) quando il dischetto è inserito.
auto.stopped=Lettura automatica fermata per questo disco: premi Leggi (F5) quando sei pronto.
auto.typing=Stai scrivendo: leggo quando premi Invio o Leggi (F5).

# the volume label
label.reading=Leggo l'etichetta del disco...
label.kept=Etichetta del disco: %ls (resta quella che hai scritto)
label.read=Etichetta letta dal disco: %ls
label.none=Il disco non ha un'etichetta di volume
label.nodisk=Nessun disco nel lettore %ls
label.unknown=Windows non riconosce il disco: l'etichetta si prende dall'immagine dopo la lettura

# the banners while waiting for a disk
insert.floppy=Inserisci il %ls %d di %d
insert.floppy.manual=Poi premi Invio o Leggi (F5); F2 rilegge l'etichetta, Alt+S salta il disco. Etichetta del disco (facoltativa):
insert.floppy.auto=Lettura automatica: appena il dischetto è nel lettore parto da solo. Invio o F5 legge subito, Alt+S salta, Esc torna alla lettura a mano. Etichetta del disco (facoltativa):
insert.floppy.auto.next=Lettura automatica: togli il dischetto appena letto e inserisci questo, parto da solo. Invio o F5 legge subito, Alt+S salta, Esc torna alla lettura a mano. Etichetta del disco (facoltativa):
insert.optical=Inserisci il %ls %d di %d nel lettore %ls
insert.optical.one=Inserisci il %ls nel lettore %ls
insert.optical.manual=Chiudi il lettore, aspetta che la spia smetta di lampeggiare, poi premi Invio o Leggi (F5); F2 rilegge l'etichetta, Alt+S salta. La lettura con DiscImageCreator dura da 10 a 30 minuti. Etichetta del %ls (facoltativa):
insert.optical.auto=Lettura automatica: %ls, quando Windows lo vede parto da solo (da 10 a 30 minuti). Invio o F5 legge subito, Alt+S salta, Esc torna alla lettura a mano. Etichetta del %ls (facoltativa):
insert.optical.first=inserisci il disco
insert.optical.next=togli il disco appena letto e inserisci questo
unreadable.title=%ls %d di %d: la lettura dei %ls non c'è ancora
unreadable.text=Il %ls resta da leggere e il cofanetto aperto: lo riprenderai con Riprendi quando RetroArchiver saprà leggere i %ls. Premi Salta per continuare.
duplicate.title=Il %ls è identico al %ls
duplicate.other=un altro disco
duplicate.text.auto=Togli il %ls e inserisci il %ls giusto: riparto da solo. Oppure Rileggi (F5) o Salta (Alt+S). Le letture sbagliate sono in set-aside, non cancellate; se i due dischi sono davvero uguali, rileggilo: alla seconda volta lo tengo.
duplicate.text=Togli il %ls, inserisci il %ls giusto e premi Rileggi (F5), oppure Salta (Alt+S). Le letture sbagliate sono in set-aside, non cancellate; se i due dischi sono davvero uguali, rileggilo: alla seconda volta lo tengo.
retry.interrupted=%ls %d: lettura interrotta
retry.failed=%ls %d: lettura non riuscita
retry.text.interrupted=Premi Riprova per rileggerlo, Salta per passare al successivo, oppure chiudi la finestra: il cofanetto resta aperto e lo riprendi dall'archivio
retry.text.floppy.auto=Controlla il dischetto e rimettilo nel lettore: riparto da solo. Oppure premi Riprova (F5) o Salta (Alt+S).
retry.text.floppy=Controlla il dischetto, rimettilo nel lettore e premi Riprova (F5), oppure Salta (Alt+S).
retry.text.why=%ls\nPoi premi Riprova (F5), oppure Salta (Alt+S).
retry.text.disc=Controlla il disco (il tipo giusto, pulito), rimettilo nel lettore e premi Riprova (F5), oppure Salta (Alt+S).
retry.protection.title=%ls %d: rileggerlo cercando le protezioni anticopia
retry.protection.failed=La lettura è stata fatta senza la ricerca delle protezioni anticopia: Riprova (F5) lo rilegge con la ricerca (DiscImageCreator /sf), Salta (Alt+S) passa oltre.
retry.protection.errors=La lettura, fatta senza la ricerca delle protezioni anticopia, ha degli errori: una protezione può causarli. Riprova (F5) lo rilegge con la ricerca (DiscImageCreator /sf); Salta (Alt+S) tiene quello che è stato letto.
retry.protection.off.title=%ls %d: rileggerlo senza cercare le protezioni anticopia
retry.protection.off.text=Con la ricerca delle protezioni anticopia (DiscImageCreator /sf) il lettore si è resettato più volte (UNIT_ATTENTION, timeout): la causa è la ricerca, non il disco. Riprova (F5) lo rilegge senza, Salta (Alt+S) passa oltre.

# the banners during the read
start.title=Preparo il cofanetto...
start.text=Creo il pacchetto o riprendo quello aperto.
work.floppy.text=%ls %d di %d%ls. Non togliere il dischetto finché la lettura non è finita.
work.reread=Le letture non coincidono: faccio un'altra lettura
work.fragile=Disco fragile: una sola lettura prudente
work.reading=Lettura in corso: non togliere il dischetto
work.optical.text=%ls %d di %d nel lettore %ls%ls. Non aprire il lettore finché la lettura non è finita: un CD intero richiede da 10 a 30 minuti.
work.optical.reread=Una lettura non basta: rileggo il %ls per il confronto
work.optical.reading=Lettura in corso: non togliere il %ls
answer.skip=Salto il %ls.
answer.later=Il %ls resta da leggere.
answer.closing=Chiudo il cofanetto...
answer.closing.text=Calcolo e ricontrollo le impronte SHA-256 dei file.
stop.title=Interrompo la lettura...
stop.dic=DiscImageCreator si ferma fra poco. La lettura a metà non resta nel pacchetto.
stop.samdisk=SAMdisk si ferma fra poco.
stop.compare=Il confronto finisce da solo fra poco
stop.compare.last=È l'ultimo disco del cofanetto: aspetta qui l'esito, non c'è un disco successivo da chiedere
stop.compare.next=Quando ti chiede il disco successivo puoi chiudere la finestra: il cofanetto resta aperto e lo riprendi dall'archivio
stop.none=Qui non c'è una lettura da fermare
stop.none.text=Aspetta qualche secondo.

# the log
log.box.done=Cofanetto %ls: pacchetto chiuso e verificato.
log.box.complete=completo
log.box.incomplete=incompleto
log.error=ERRORE: %ls
banner.error=Errore

# the end of the box
end.complete=Cofanetto completo: %ls su %d
end.incomplete=Cofanetto chiuso incompleto: %ls su %d
end.closed.text=%ls.\nIl pacchetto è chiuso e verificato.%ls
end.aside=\sFuori dai dati restano le letture messe da parte: guardale e, se non servono, cancellale.
end.later=\nRiprendilo dall'archivio quando RetroArchiver saprà leggere %ls.
end.later.both=i CD e i DVD
end.later.cd=i CD
end.later.dvd=i DVD
end.open=Cofanetto lasciato aperto
end.open.how=\nPer riprenderlo: Archivio, poi doppio clic sul cofanetto.
end.failed=Archiviazione non riuscita
end.failed.text=%ls%lsLeggi il registro qui sotto, correggi e riprova con Nuovo cofanetto.
summary.nothing=nessun supporto

# questions and errors
finish.ask.one=Manca ancora: %ls.\n\nSe chiudo il cofanetto adesso risulterà incompleto, con quel supporto mancante, e non si potrà più riprendere dall'archivio.\n\nChiudo il cofanetto?
finish.ask.many=Mancano ancora: %ls.\n\nSe chiudo il cofanetto adesso risulterà incompleto, con quei supporti mancanti, e non si potrà più riprendere dall'archivio.\n\nChiudo il cofanetto?
close.ask=C'è un cofanetto in corso. Lo lascio aperto (si riprende dall'archivio) e chiudo?
error.memory=Memoria insufficiente.
error.nostart=Non riesco ad avviare la sessione.
