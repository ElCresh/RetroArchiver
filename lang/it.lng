choose.new=Nuova
choose.row.outcome=Esito
choose.row.method=Letta con
choose.row.drive=Lettore
choose.row.date=Data
choose.keep.new=Tieni la nuova
choose.keep.old=Tieni quella di prima
edit.wait=Aspetta: si sta salvando il cofanetto. Chiudendo adesso, la modifica andrebbe rimessa in ordine la prossima volta.

# conversione dei cofanetti della 261017
menu.convert=&Converti i cofanetti della 261017...
convert.title=Cofanetti della 261017
convert.text=%d cofanetti di questo archivio sono stati fatti con RetroArchiver 261017. Si leggono come sono; per modificarli vanno convertiti al formato di oggi.\n\nOgni pacchetto si controlla prima: uno danneggiato non si tocca. Il metadata.json vecchio resta in set-aside, in data/ non cambia niente. Non è mai obbligatorio.
convert.go=Converti
convert.later=Più tardi
convert.never=Non chiedere più
convert.progress=Conversione %d di %d: “%ls”...
convert.done=Cofanetti convertiti: %d. Non convertiti: %d.%ls
convert.line=\n• %ls: %ls
convert.hint=\n\nUn cofanetto non convertito è com'era. Per uno danneggiato, Ricontrolla impronte dice quale file non torna.
convert.before.edit=“%ls” è stato fatto con RetroArchiver 261017: per modificarlo va prima convertito. Il pacchetto si controlla prima e in data/ non cambia niente.\n\nConvertirlo adesso?
convert.none=In questo archivio non ci sono cofanetti della 261017.

# perché un cofanetto della 261017 non è stato convertito
convert.why.notbox=non è più un cofanetto
convert.why.open=è ancora aperto: riprendilo, e chiudendolo si converte
convert.why.broken=il suo metadata.json o i suoi manifest non si leggono
convert.why.damaged=%ls non corrisponde alla sua impronta, quindi il cofanetto non si tocca
convert.why.unfinished=una modifica interrotta non si è ancora potuta rimettere in ordine: riprova più tardi
convert.why.failed=il pacchetto non si è potuto modificare ed è com'era: chiudi i programmi che possono tenerne aperti i file e riprova
convert.wait=Aspetta: si stanno convertendo i cofanetti della 261017, uno alla volta. Ognuno richiede un po' di tempo; la finestra si può riusare quando compare il riepilogo.

# i messaggi del nucleo (src/core/messages.h), quando la finestra li mostra
core.medium.floppy=floppy %ls
core.medium.cd=CD %ls
core.medium.dvd=DVD %ls
core.ses.read.back=non riesco a rileggere %ls, appena scritto: controlla il disco di destinazione.
core.ses.move.aside=non riesco a spostare data/%ls in %ls: è aperto in un altro programma? Chiudilo e ricomincia.
core.ses.remove=non riesco a togliere data/%ls: è aperto in un altro programma? Chiudilo e ricomincia.
core.ses.closed=Il cofanetto “%ls” è già chiuso in %ls: scegli un altro titolo, oppure distinguilo con la versione.
core.ses.mkdir.perm=Non riesco a creare la cartella %ls: controlla i permessi.
core.ses.holds=La cartella %ls contiene il cofanetto %ls, non %ls: scegli un altro titolo, oppure riprendi quel cofanetto con il suo titolo e la sua versione esatti.
core.ses.names=Lo schema dei nomi “%ls” dà lo stesso nome a supporti diversi: usa {n}, {nn} o {nnn} e un titolo più corto.
core.ses.not.in.manifest=%ls non è nel manifest del cofanetto: spostalo fuori da data e riprova.
core.ses.reread.too=%ls non corrisponde più alla sua impronta: rileggi anche %ls.
core.ses.damaged=%ls non corrisponde più alla sua impronta: il cofanetto è danneggiato.
core.ses.no.box=Non c'è un cofanetto “%ls” in %ls: controlla il titolo e la versione.
core.ses.not.editable=Il cofanetto in %ls non si può modificare: %ls.
core.ses.edit.holds=La cartella %ls contiene il cofanetto “%ls”, non “%ls”: usa il suo titolo e la sua versione esatti.
core.ses.nomem=Memoria esaurita.
core.ses.stays.err=%ls. %ls resta com'era.
core.ses.mkdir.path=Non riesco a creare la cartella %ls: controlla il percorso.
core.ses.too.many=Troppi supporti: al massimo %ls per cofanetto.
core.ses.close.failed=%ls. Ricomincia con lo stesso titolo: %ls verrà chiesto di nuovo.
core.meta.write=non riesco a scrivere %ls: il disco di destinazione è pieno o protetto dalla scrittura?
core.meta.not.found=non trovo %ls: se il cofanetto è danneggiato, sposta altrove la sua cartella e ricomincia
core.meta.unreadable=%ls non si legge (%ls): se il cofanetto è danneggiato, sposta altrove la sua cartella e ricomincia
core.meta.newer=%ls viene da una versione più nuova di RetroArchiver: aggiorna il programma per aprire questo cofanetto
core.meta.not.box=%ls non è un cofanetto di RetroArchiver: se il cofanetto è danneggiato, sposta altrove la sua cartella e ricomincia
core.bag.mkdir=non riesco a creare la cartella %ls
core.bag.write=non riesco a scrivere %ls
core.bag.read=non riesco a leggere %ls
core.bag.no.data=mancano il titolo, la piattaforma o la composizione: compilali prima di chiudere il cofanetto
core.bag.missing=data/%ls non c'è: rileggi %ls
core.bag.changed=data/%ls è cambiato dopo la lettura (impronta diversa): rileggi %ls
core.bag.remove.mark=non riesco a togliere %ls da %ls: controlla i permessi
core.arc.no.manifest=in %ls manca manifest-sha256.txt: il pacchetto non è stato chiuso bene
core.txn.missing=%ls non c'è in %ls: non è cambiato niente
core.txn.exists=%ls esiste già in %ls: non è cambiato niente
core.txn.folder.exists=la cartella %ls esiste già: scegli un altro titolo o un'altra versione
core.txn.mkdir=non riesco a creare %ls
core.txn.copy=non riesco a copiare %ls
core.txn.move=non riesco a spostare %ls in %ls: è aperto in un altro programma?
core.txn.disk.full=non riesco a scrivere i manifest: il disco è pieno?
core.txn.no.match=il pacchetto nuovo non corrisponde al suo manifest
core.txn.manifests=i manifest di %ls non si leggono
core.txn.line=%ls non corrisponde al manifest nuovo
core.txn.extra=data/ in %ls ha file che il manifest nuovo non elenca
core.txn.rename=non riesco a rinominare %ls: chiudi la cartella se è aperta in Esplora risorse e riprova
core.edit.not.box=%ls non è un cofanetto
core.edit.interrupted=una modifica di questo cofanetto è stata interrotta: riapri l'archivio per finirla o annullarla
core.edit.open=il cofanetto è ancora aperto: riprendilo
core.edit.unreadable=il cofanetto non si legge: %ls
core.edit.old=il cofanetto è stato fatto con RetroArchiver 261017: convertilo prima
core.edit.names.long=i nomi dei file dei %ls usano il titolo, e con “%ls” sarebbero troppo lunghi: scegli un titolo più corto
core.edit.damaged=%ls non corrisponde al manifest: rileggi quel supporto con Modifica, senza cambiare i dati del cofanetto
core.edit.nomem=memoria esaurita
core.edit.empty=il titolo e la piattaforma non possono essere vuoti
core.edit.history.full=la storia del cofanetto è piena: non si possono registrare altre modifiche
core.flp.notool=Non trovo %ls: mettilo nella cartella del programma o nel PATH, oppure indica il percorso completo di samdisk.exe.
core.opt.nodll=%ls non parte: mancano i runtime di Visual C++ 2015-2019 x86 (VCRUNTIME140.dll). Su Windows XP installa la versione 14.27 del Visual C++ Redistributable.
core.opt.notool=Non trovo %ls: mettilo nella stessa cartella del programma o nel PATH, oppure indica il percorso completo di DiscImageCreator.exe.
core.opt.fat32=la cartella è su un disco %ls, che non regge file oltre i 4 GB, e l'immagine di questo disco sarà di %ls MB: scegli una cartella su un disco NTFS
core.opt.ansi=il nome della cartella %ls ha caratteri che DiscImageCreator (un programma ANSI) non legge, e non ha un nome corto 8.3: scegli una cartella dell'archivio senza lettere straniere nel nome
core.opt.space=%ls ha %ls MB liberi e la lettura ne chiede circa %ls: libera dello spazio o scegli un'altra cartella dell'archivio
core.opt.cannot.read=Non riesco a leggere il %ls: %ls.
core.opt.mkdir=Non riesco a creare la cartella %ls: controlla il disco di destinazione.
core.opt.last.line=\sUltima riga: “%ls”.
core.opt.stopped=DiscImageCreator si è fermato con l'errore %ls.%ls Controlla che il disco sia nel lettore %ls: e pulito, e lo spazio nella cartella %ls (%ls MB liberi), poi riprova.
core.opt.model=il modello %ls
core.opt.model.unknown=il modello di questo lettore (lo dice il registro _drive.txt della lettura)
core.opt.offset=L'offset di lettura del lettore non è impostato e DiscImageCreator non conosce questo lettore: cercalo per %ls nell'elenco di AccurateRip o di redump e impostalo in Strumenti > Impostazioni, CD e DVD (dskrun: --drive-offset), poi rileggi.
core.opt.resets.sf=Il lettore si è resettato %ls volte mentre DiscImageCreator cercava le protezioni (/sf): l'ho fermato, andrebbe avanti così per un'ora. Rileggi il CD senza la ricerca delle protezioni (Protezioni anticopia: Disattivo).
core.opt.wrong.disc=Il lettore non contiene un %ls: per DiscImageCreator il disco è di un altro tipo. Controlla il disco, o il contenuto del cofanetto.
core.opt.denied=DiscImageCreator non riesce ad aprire il lettore %ls: (accesso negato): avvia il programma come amministratore.
core.opt.c2.slower=DiscImageCreator si è fermato con %ls settori ancora illeggibili dopo %ls riletture (errori C2) a %lsx: lì il disco è graffiato o sporco. Riprova (F5) lo rilegge a %lsx; lavarlo prima aiuta (acqua e una goccia di sapone, asciugato dal centro verso il bordo).
core.opt.c2.lowest=DiscImageCreator si è fermato con %ls settori ancora illeggibili dopo %ls riletture (errori C2) a %lsx, la velocità più bassa che RetroArchiver usa: lì il disco è graffiato o sporco. Lavalo con acqua e una goccia di sapone, asciugalo dal centro verso il bordo e riprova, oppure leggilo con un altro lettore.
core.opt.firmware=DiscImageCreator non legge con questo lettore finché il suo firmware non è l'ultimo: aggiorna il firmware del lettore (il registro di DiscImageCreator dice dove trovarlo), riavvia il PC e rileggi il %ls.
core.opt.incomplete=DiscImageCreator ha finito ma manca %ls: la lettura è incompleta.
core.opt.with.resets=%ls Il lettore si è resettato durante la lettura (UNIT_ATTENTION, timeout): la ricerca delle protezioni non aiuterebbe, fa resettare il lettore ancora di più.

